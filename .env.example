# ---- Application ----
PROJECT_NAME=LLM Visibility Monitor
VERSION=0.2.0

# ---- Result repository: console | json | bigquery ----
RESULT_REPOSITORY=json
RESULTS_DIR=data/results
# Max runs the history API / alerts read back (BigQuery reader)
HISTORY_MAX_RUNS=100

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Azure OpenAI ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# ---- Perplexity (OpenAI-compatible) ----
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# ---- BigQuery (required only when RESULT_REPOSITORY=bigquery) ----
GCP_PROJECT_ID=
BIGQUERY_DATASET=
BIGQUERY_TABLE=prompt_run_results

# ---- Scheduled runs (disabled by default) ----
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 6 * * *
SCHEDULE_TIMEZONE=Asia/Tokyo
SCHEDULE_PROVIDERS=openai
# empty = all prompts in prompts.yaml
SCHEDULE_PROMPT_IDS=

# ---- Alerts (disabled by default) ----
ALERT_ENABLED=false
ALERT_SCORE_DROP_THRESHOLD=20
# Set one of the webhook URLs (Google Chat takes precedence if both are set)
GOOGLE_CHAT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---- Visibility analysis ----
ANALYSIS_ENABLED=true
SENTIMENT_ENABLED=true
BRANDS_FILE=prompts/brands.yaml
